# Google Sheets API for community levels (GitHub Pages deployment)
#
# To set up:
# 1. Create a Google Sheet
# 2. Go to Extensions → Apps Script
# 3. Paste the code from docs/google-apps-script.js
# 4. Deploy → New deployment → Web app
# 5. Set "Who has access" to "Anyone"
# 6. Copy the web app URL here
#
VITE_SHEETS_API=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
